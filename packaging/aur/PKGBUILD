# Maintainer: rajput-hemant
# Binary package built from the GitHub release's static (musl) tarballs.
# The double-underscore placeholders are filled by packaging/fill.sh.
pkgname=dman-bin
pkgver=__VERSION__
pkgrel=1
pkgdesc='Terminal-first download manager built on aria2 (optional yt-dlp for video)'
arch=('x86_64' 'aarch64')
url='https://github.com/rajput-hemant/dman'
license=('MIT OR Apache-2.0')
depends=('aria2')
optdepends=('yt-dlp: video downloads'
            'ffmpeg: merge and convert video downloads')
provides=('dman')
conflicts=('dman')
options=('!strip' '!debug')
source_x86_64=("dman-${pkgver}-x86_64.tar.gz::${url}/releases/download/v${pkgver}/dman-x86_64-unknown-linux-musl.tar.gz")
source_aarch64=("dman-${pkgver}-aarch64.tar.gz::${url}/releases/download/v${pkgver}/dman-aarch64-unknown-linux-musl.tar.gz")
sha256sums_x86_64=('__SHA256_LINUX_X86_64__')
sha256sums_aarch64=('__SHA256_LINUX_AARCH64__')

package() {
  cd "dman-${CARCH}-unknown-linux-musl"
  install -Dm755 dman "${pkgdir}/usr/bin/dman"
  install -Dm644 LICENSE-MIT "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE-MIT"
  install -Dm644 LICENSE-APACHE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE-APACHE"
  install -Dm644 README.md "${pkgdir}/usr/share/doc/${pkgname}/README.md"
}
